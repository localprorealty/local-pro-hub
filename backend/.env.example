# =============================================================================
# LocalPRO Hub — Backend environment variables
# =============================================================================
#
# Quick start (minimum for what the app uses today):
#   1. cp .env.example .env
#   2. Fill in SUPABASE_* (required for POST /admin/users — Add user in admin roster)
#   3. Set N8N_SIGNUP_WEBHOOK_URL if you want signup → admin email via n8n
#   4. Keep CORS_ORIGINS matching your Vite dev URL (default below)
#   5. source venv/bin/activate && uvicorn main:app --reload --port 8000
#
# Frontend must point at this API (see frontend/.env.example):
#   VITE_API_BASE_URL=http://localhost:8000
#
# Never commit .env. The service role key bypasses RLS — treat it like a root password.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED for admin “Add user” (POST /admin/users)
# -----------------------------------------------------------------------------
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key (secret): same page → service_role — NOT the anon/public key
# Used server-side only: verify admin JWT, create auth users, patch public.users
SUPABASE_SERVICE_KEY=


# -----------------------------------------------------------------------------
# RECOMMENDED for local dev (signup pending → n8n → Gmail)
# -----------------------------------------------------------------------------
# Full webhook URL (path /webhook/..., NOT /workflow/webhook/...).
# n8n workflow must be Active; path must match the Webhook node in n8n.
#
# Same machine (backend + n8n on localhost):
N8N_SIGNUP_WEBHOOK_URL=http://localhost:5678/webhook/localpro-signup-pending
#
# Admin → Automations → Run milestone emails now
N8N_MILESTONE_WEBHOOK_URL=http://localhost:5678/webhook/localpro-run-milestones
#
# Photography booking → notify photographer (email + SMS via n8n)
N8N_BOOKING_WEBHOOK_URL=http://localhost:5678/webhook/localpro-photography-booked
#
N8N_GO_LIVE_WEBHOOK_URL=http://localhost:5678/webhook/localpro-listing-live
#
# Listing transition to Marketing -> notify marketing team (via n8n)
N8N_MARKETING_WEBHOOK_URL=http://localhost:5678/webhook/localpro-marketing-pending
#
# Optional — forwarded in go-live payload for n8n Lofty HTTP node
# LOFTY_WEBHOOK_URL=
#
# Optional — used in listing_url in go-live n8n payload (defaults to first CORS origin)
# FRONTEND_URL=http://localhost:5173
#
# If the frontend calls the API through ngrok, n8n can still use localhost above.
# Only use ngrok for n8n when n8n runs elsewhere:
# N8N_SIGNUP_WEBHOOK_URL=https://YOUR-NGROK-ID.ngrok-free.dev/webhook/localpro-signup-pending
#
# If unset: POST /internal/notify-signup-pending returns skipped (no email); app still works.

# Optional legacy base URL (not used by main.py today; reserved for future workflows)
# N8N_WEBHOOK_BASE_URL=http://localhost:5678


# -----------------------------------------------------------------------------
# APP / server (used on every request)
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call this API (must include your Vite URL)
CORS_ORIGINS=http://localhost:5173

# Bind address for uvicorn (defaults are fine for local dev)
API_HOST=0.0.0.0
API_PORT=8000


# =============================================================================
# NOT WIRED YET — placeholders for future phases (safe to leave empty)
# =============================================================================

# -----------------------------------------------------------------------------
# RECOMMENDED — NTREIS RETS property search (POST /rets/search)
# Live Matrix MLS — not local mock data. Frontend → FastAPI → ntrdd.mlsmatrix.com
# -----------------------------------------------------------------------------
NTREIS_RETS_URL=https://ntrdd.mlsmatrix.com/rets/Login.ashx
NTREIS_RETS_USERNAME=
NTREIS_RETS_PASSWORD=

# GROQ (LLM + Whisper) — required for POST /voice/transcribe and /voice/extract
GROQ_API_KEY=

# HeyGen — Market Yourself avatar training + video generation (POST /marketing/*)
# Dashboard → Settings → API. Header: X-Api-Key
# Pricing: https://developers.heygen.com/docs/pricing
HEYGEN_API_KEY=

# Gmail SMTP (if sending mail from Python instead of n8n)
# GMAIL_USER=noreply@localpro.com
# GMAIL_APP_PASSWORD=

# Resend (transactional email from API)
# RESEND_API_KEY=

# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Stripe (billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# BrokerMint Integration
BROKERMINT_API_KEY=
BROKERMINT_WEBHOOK_SECRET_CREATED=
BROKERMINT_WEBHOOK_SECRET_UPDATED=
